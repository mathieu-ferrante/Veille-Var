# Copier ce fichier en ".env" puis renseigner les clés. Le fichier .env n'est JAMAIS versionné.
# Seules les clés des fournisseurs réellement utilisés sont nécessaires.

# Service recommandé (production) – voir config.yaml > production.fournisseur
MISTRAL_API_KEY=

# Fournisseurs testés dans le benchmark (facultatifs)
ALBERT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modèle local (Ollama) : aucune clé, mais l'URL peut être changée
OLLAMA_BASE_URL=http://localhost:11434/v1

# Diffusion par mail de la synthèse (facultatif)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Destinataires séparés par des virgules (listes de diffusion de service, pas d'adresses personnelles)
SMTP_TO=
